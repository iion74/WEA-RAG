# Models evaluated in the paper.
MODEL_KEYS="${MODEL_KEYS:-qwen llama minicpm}"
SPLITS="${SPLITS:-distractor fullwiki}"

# Standalone baseline and RAG generation configuration.
MAX_NEW_TOKENS=32
CONTEXT_K=8
MAX_CONTEXT_CHARS=16000
SEED=13

# The WEA-RAG run generated both its internal RAG draft and WEA candidate
# with this limit.
WEA_MAX_NEW_TOKENS=64

# Retrieval configuration described in the paper.
TOP_K=8
DENSE_K=200
RERANK_K=120
RETRIEVAL_BATCH_SIZE=32
SUBQUESTION_MAX=3
HOP_TITLES_K=2
# Graph seed count is max(4, HOP_TITLES_K * 2), therefore four here.
BRIDGE_QUERY_PER_DOC=2
DENSE_WEIGHT=0.05
GRAPH_CONNECTIVITY_WEIGHT=0.20
QUESTION_OVERLAP_WEIGHT=0.10

# Selective WEA gate.
COVERAGE_THRESHOLD=0.78
MIN_MISSING_TERMS=2
WEB_TOP_K=8
WEB_QUERY_STRATEGY=question_then_missing
MAX_WEB_CHARS=6000
MAX_TOTAL_CHARS=20000

# Guarded selector shared thresholds. Model/split margins are in
# scripts/run_wea_rag.sh and artifacts/analysis/selector_tuning.json.
WEA_MIN_SCORE=0.65
WEA_MIN_TOKEN_SUPPORT=0.55
RAG_LOCK_SCORE=0.88
